# Leave blank to use the Vite /api development proxy.
# For a separately hosted API, use its origin, for example:
# VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=

# Optional target for Vite's local /api proxy (used only when the base URL is blank).
ROUTEWISE_API_PROXY_TARGET=http://127.0.0.1:8000
